# ==============================================================================
# Quizwise AI Multi-Provider Configuration
# ==============================================================================

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
GEMINI_TIMEOUT=15.0

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=true
GROQ_TIMEOUT=15.0

# --- OpenRouter ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_ENABLED=true
OPENROUTER_TIMEOUT=15.0

# --- Parallel Racing & Reliability Settings ---
PROVIDER_MAX_RETRIES=1
PROVIDER_COOLDOWN_SECONDS=60.0
PROVIDER_CONCURRENCY_LIMIT=3
PROVIDER_OVERALL_TIMEOUT=30.0

# --- Authentication & Secrets ---
JWT_SECRET_KEY=your_jwt_secret_key_here
FIREBASE_SERVICE_ACCOUNT_PATH=D:\PythonProject\QuizWise-Secrets\serviceAccountKey.json

